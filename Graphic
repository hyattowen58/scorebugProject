#include "raylib.h"

int main(void) 
{

    InitWindow(800, 450, "BaseBall Graphic example");

    SetTargetFPS(60);

    while (!WindowShouldClose()) 

    {

        BeginDrawing();

            ClearBackground(RAYWHITE);

            // Main rectangle
            DrawRectangle(100, 175, 600, 100, LIME);
            
            DrawLineEx({ 100, 175 }, { 700, 175 }, 3, BLACK);
            DrawLineEx({ 100, 275 }, { 700, 275 }, 3, BLACK);
            DrawLineEx({ 100, 175 }, { 100, 275 }, 3, BLACK);
            DrawLineEx({ 700, 175 }, { 700, 275 }, 3, BLACK);

            // main diamonds
            Vector2 top    = { 400, 75 };
            Vector2 bottom = { 400, 375 };
            Vector2 left   = { 250, 225 };
            Vector2 right  = { 550, 225 };

            DrawTriangle(top, left, right, BEIGE);
            DrawTriangle(bottom, right, left, BEIGE);

            DrawLineEx(top, left, 2, BLACK);
            DrawLineEx(left, bottom, 2, BLACK);
            DrawLineEx(bottom, right, 2, BLACK);
            DrawLineEx(right, top, 2, BLACK);

            //top diamonds
            Vector2 top1    = { 400, 85 };
            Vector2 bottom1 = { 400, 205 };
            Vector2 left1   = { 340, 145 };
            Vector2 right1  = { 460, 145 };

            DrawTriangle(top1, left1, right1, WHITE);
            DrawTriangle(bottom1, right1, left1, WHITE);

            DrawLineEx(top1, left1, 3, BLACK);
            DrawLineEx(left1, bottom1, 3, BLACK);
            DrawLineEx(bottom1, right1, 3, BLACK);
            DrawLineEx(right1, top1, 3, BLACK);

           // left diamonds
            Vector2 top2    = { 320, 165 };
            Vector2 bottom2 = { 320, 285 };
            Vector2 left2   = { 260, 225 };
            Vector2 right2  = { 380, 225 };

            DrawTriangle(top2, left2, right2, GRAY);
            DrawTriangle(bottom2, right2, left2, GRAY);

            DrawLineEx(top2, left2, 3, BLACK);
            DrawLineEx(left2, bottom2, 3, BLACK);
            DrawLineEx(bottom2, right2, 3, BLACK);
            DrawLineEx(right2, top2, 3, BLACK);

            // right diamonds
            Vector2 top3    = { 480, 165 };
            Vector2 bottom3 = { 480, 285 };
            Vector2 left3   = { 420, 225 };
            Vector2 right3  = { 540, 225 };

            DrawTriangle(top3, left3, right3, GRAY);
            DrawTriangle(bottom3, right3, left3, GRAY);

            DrawLineEx(top3, left3, 3, BLACK);
            DrawLineEx(left3, bottom3, 3, BLACK);
            DrawLineEx(bottom3, right3, 3, BLACK);
            DrawLineEx(right3, top3, 3, BLACK);

            // to do 
            //  DrawText("Home Team 0", 20, 20, 30, BLACK);
            //  DrawText("Away Team 0", 700, 20, 30, BLACK);
            // DrawText("0-0", 300, 400, 20, BLACK);
           // DrawText("outs 0", 20, 20, 30, BLACK);

        EndDrawing();

    }

    CloseWindow();

    return 0;
}
