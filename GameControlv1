// Work in Progress GameControl class, version 1
#include <iostream>
using namespace std;

class GameControl 
{ 
    // Important Variables 
    private: 
        int inning = 1;
        int ballCount = 0;
        int strikeCount = 0;
        int outCount = 0;

public:
    // Debug Tools
    void setValues(int i = 0, int b = 0, int s = 0, int o = 0)
    {
        inning = i;
        ballCount = b;
        strikeCount = s;
        outCount = o;
    }

    void viewAll()
    {
        // cout << "Inning: " << inning << "\nBall Count: " << ballCount << "\nStrike Count: " << strikeCount
           // << "\nOut Count: " << outCount << endl;
        cout << "Strike Count: " << strikeCount << "  Out: " << outCount << "  Inning: " << inning << endl;
    }
   
    // Adds the ball on demand, but resets the score after four balls
    void recordBall()
    {
        ballCount++;
        if (ballCount >= 4)
        {
            ballCount = 0;
            strikeCount = 0;
        }
    }

    // Adds a strike on demand, then makes changes based on the game state
    void recordStrike()
    {
        strikeCount++;
        if (strikeCount >= 3 && outCount < 2) // third strike and 1st or 2nd out
        {
            outCount++;
            strikeCount = 0;
        }
        else if (strikeCount >= 3 && outCount >= 2) // third strike and 3rd out
        {
            inning++;
            strikeCount = 0;
            outCount = 0;
        }
    }

    // Adds an out on demand, then makes changes based on game state
    void recordOut()
    {
        outCount++;
        // checks if three outs are reached, then goes to the next inning and resets the count 
        if (outCount >= 3)
        {
            inning++;
            outCount = 0;
            ballCount = 0;
        }
    }

    // Adds strikes until it reaches two strikes
    void handleFoul()
    {
        if (strikeCount < 2)
        {
            strikeCount++;
        }
    }

    void resetGame()
    {
        inning = 1;
        ballCount = 0;
        strikeCount = 0;
        outCount = 0;
    }
};

int main() 
{
    // Debug area
    GameControl newGame;
    newGame.setValues(1, 2, 3, 4);
    newGame.viewAll();
    newGame.resetGame();
    newGame.viewAll();
    return 0;
}
